{
  "name": "nova-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:be\" \"npm:dev:web\"",
    "dev:be": "tsx watch BE/src/server.ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts && tsx scripts/build-extension.ts",
    "start": "tsx BE/src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:browser": "playwright install chromium",
    "check:providers": "tsx scripts/check-providers.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:extension": "tsx scripts/extension-smoke.ts",
    "test:voice": "tsx scripts/voice-ui-smoke.ts",
    "test:launcher": "tsx scripts/launcher-smoke.ts",
    "test:tabs": "tsx scripts/tab-launch-smoke.ts",
    "test:microphone": "tsx scripts/microphone-smoke.ts",
    "test:control": "tsx scripts/browser-control-smoke.ts",
    "test:models": "tsx scripts/model-smoke.ts",
    "test:general": "tsx scripts/general-agent-smoke.ts",
    "test:questions": "tsx scripts/question-card-smoke.ts",
    "test:question-panel": "tsx scripts/question-panel-smoke.ts",
    "test:workflow-loop": "tsx scripts/workflow-loop-smoke.ts",
    "test:panel": "tsx scripts/panel-experience-smoke.ts",
    "test:launcher-visibility": "tsx scripts/launcher-visibility-smoke.ts",
    "test:bolna": "tsx scripts/bolna-smoke.ts",
    "demo:bolna": "tsx scripts/bolna-demo.ts",
    "test:bolna-demo": "tsx scripts/bolna-demo-smoke.ts",
    "test:bolna-creation": "tsx scripts/bolna-creation-smoke.ts",
    "test:bolna-panel": "tsx scripts/bolna-panel-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tldts": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.20",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "fflate": "^0.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
