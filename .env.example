# Copy to .env. Provider keys must stay on the backend.
OPENAI_API_KEY=
SARVAM_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
PORT=8787
HOST=127.0.0.1
BROWSER_HEADLESS=false
# Optional stable pairing token, at least 32 characters. Otherwise generated locally.
NOVA_TOKEN=
# Set only for isolated automated fixture tests, never an exposed deployment.
NOVA_ALLOW_LOCAL_TESTS=false
